{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dire-bet",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "BOT_USERNAME": "Dire_Bet_bot",
    "REAL_MONEY_ENABLED": "false",
    "DEMO_MODE": "false",
    "SIMULATED_WALLET_ENABLED": "true"
  },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram/*", "/ws/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dire-bet-db",
      "database_id": "dc2fa118-8ddc-4cdb-b228-745c32659d83",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "PRESENCE", "class_name": "Presence" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker", "Presence", "RateLimiter"] }
  ],
  "triggers": { "crons": ["*/5 * * * *"] }
}
